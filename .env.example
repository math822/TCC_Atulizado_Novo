# Supabase / PostgreSQL
# Use a URL de conexão sem senha real. Para migrations, DIRECT_URL deve ser a conexão direta.
DATABASE_URL="postgresql://postgres:SENHA@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:SENHA@HOST:5432/postgres"

# Google OAuth
GOOGLE_CLIENT_ID="SEU_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="SEU_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Necessário para criar contas admin pelo /api/auth/register.
# Sem essa variável definida, a rota recusa qualquer cadastro como admin.
ADMIN_SECRET="defina-um-segredo-forte-aqui"

# Storage do Supabase (fotos de negócio e de perfil).
# SUPABASE_URL é o endereço do projeto (Settings → API).
# SUPABASE_SERVICE_ROLE_KEY é a chave "service_role" — NUNCA va para o cliente.
# O bucket "midias" é criado sozinho no primeiro upload, pode deixar público.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
SUPABASE_BUCKET="midias"
