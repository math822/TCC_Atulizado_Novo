generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id_usuario         String            @id @default(uuid())
  nome               String
  email              String            @unique
  senha              String
  telefone           String?
  tipo               TipoUsuario
  cnpj               String?           @unique
  status_verificacao StatusVerificacao @default(nao_solicitada)
  foto_perfil        String?
  data_cadastro      DateTime          @default(now())

  negocios    Negocio[]
  avaliacoes  Avaliacao[]
  favoritos   Favorito[]
  comentarios Comentario[]

  conversas_como_cliente      Conversa[] @relation("cliente_conversas")
  conversas_como_empreendedor Conversa[] @relation("empreendedor_conversas")
  mensagens_enviadas          Mensagem[] @relation("mensagens_remetente")
}

model Negocio {
  id_negocio            String   @id @default(uuid())
  nome                  String
  descricao             String?  @db.Text
  telefone              String?
  horario_funcionamento String?  @db.Text
  status                String?
  data_criacao          DateTime @default(now())
  media_avaliacao       Decimal  @default(0.0) @db.Decimal(2, 1)

  id_usuario String
  usuario    Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  id_categoria String?
  categoria    Categoria? @relation(fields: [id_categoria], references: [id_categoria], onDelete: SetNull)

  endereco    Endereco?
  fotos       Foto[]
  produtos    Produto[]
  avaliacoes  Avaliacao[]
  favoritos   Favorito[]
  comentarios Comentario[]
  conversas   Conversa[]

  @@map("negocio")
}

model Endereco {
  id_endereco String  @id @default(uuid())
  cep         String?
  rua         String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  id_negocio String  @unique
  negocio    Negocio @relation(fields: [id_negocio], references: [id_negocio], onDelete: Cascade)

  @@map("endereco")
}

model Categoria {
  id_categoria String    @id @default(uuid())
  nome         String    @unique
  descricao    String?
  icone        String?
  negocios     Negocio[]

  @@map("categoria")
}

model Foto {
  id_foto    String  @id @default(uuid())
  url        String
  id_negocio String
  negocio    Negocio @relation(fields: [id_negocio], references: [id_negocio], onDelete: Cascade)

  @@map("foto")
}

model Avaliacao {
  id_avaliacao String   @id @default(uuid())
  nota         Int
  comentario   String?  @db.Text
  data         DateTime @default(now())

  id_usuario String
  id_negocio String

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  negocio Negocio @relation(fields: [id_negocio], references: [id_negocio], onDelete: Cascade)

  @@map("avaliacao")
}

model Favorito {
  id_favorito String   @id @default(uuid())
  data        DateTime @default(now())

  id_usuario String
  id_negocio String

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  negocio Negocio @relation(fields: [id_negocio], references: [id_negocio], onDelete: Cascade)

  @@unique([id_usuario, id_negocio])
  @@map("favorito")
}

model Comentario {
  id_comentario String   @id @default(uuid())
  texto         String   @db.Text
  data          DateTime @default(now())

  id_usuario String
  id_negocio String

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  negocio Negocio @relation(fields: [id_negocio], references: [id_negocio], onDelete: Cascade)

  @@map("comentario")
}

model Produto {
  id_produto   String   @id @default(uuid())
  nome         String
  descricao    String?  @db.Text
  preco        Decimal  @db.Decimal(10, 2)
  status       String?  @default("ativo") // <--- ADICIONADO AQUI
  imagem       String?
  data_criacao DateTime @default(now())

  id_negocio String
  negocio    Negocio @relation(fields: [id_negocio], references: [id_negocio], onDelete: Cascade)

  @@map("produto")
}

model Conversa {
  id_conversa     String   @id @default(uuid())
  id_cliente      String
  id_empreendedor String
  id_negocio      String?
  assunto         String?
  criado_em       DateTime @default(now())
  atualizado_em   DateTime @updatedAt

  cliente      Usuario    @relation("cliente_conversas", fields: [id_cliente], references: [id_usuario], onDelete: Cascade)
  empreendedor Usuario    @relation("empreendedor_conversas", fields: [id_empreendedor], references: [id_usuario], onDelete: Cascade)
  negocio      Negocio?   @relation(fields: [id_negocio], references: [id_negocio], onDelete: Cascade)
  mensagens    Mensagem[]

  @@index([id_cliente, id_empreendedor])
  @@index([id_empreendedor, id_cliente])
  @@map("conversa")
}

model Mensagem {
  id_mensagem String   @id @default(uuid())
  texto       String   @db.Text
  lida        Boolean  @default(false)
  data        DateTime @default(now())

  id_conversa  String
  id_remetente String

  conversa  Conversa @relation(fields: [id_conversa], references: [id_conversa], onDelete: Cascade)
  remetente Usuario  @relation("mensagens_remetente", fields: [id_remetente], references: [id_usuario], onDelete: Cascade)

  @@index([id_conversa, data])
  @@map("mensagem")
}

enum TipoUsuario {
  cliente
  empreendedor
  admin
}

enum StatusVerificacao {
  nao_solicitada
  pendente
  aprovado
  rejeitado
}
